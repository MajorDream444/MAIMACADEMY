{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/checkout",
      "destination": "/api/checkout.json"
    },
    {
      "source": "/school",
      "destination": "/api/school?action=page"
    },
    {
      "source": "/school/:section",
      "destination": "/api/school?action=page&section=:section"
    },
    {
      "source": "/school/:section/:id",
      "destination": "/api/school?action=page&section=:section&id=:id"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; style-src 'self'; img-src 'self'; script-src 'self'; connect-src 'self' https://www.majoraimindset.com; frame-ancestors 'none'; form-action 'none'; base-uri 'none'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "codex/academy-capacity-test-packet-2026-10-27": false,
      "codex/academy-qa-followup-2026-10-27": false,
      "codex/academy-launch-access-followup-2026-10-28": false,
      "codex/academy-audit-repair-2026-11-03": false,
      "codex/academy-school-v1": false
    }
  }
}
