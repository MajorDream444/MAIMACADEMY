{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [{"source":"/api/checkout","destination":"/api/checkout.json"}],
  "headers": [{"source":"/(.*)","headers":[
    {"key":"X-Robots-Tag","value":"noindex, nofollow"},
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
    {"key":"Content-Security-Policy","value":"default-src 'self'; style-src 'self'; img-src 'self'; script-src 'none'; connect-src 'none'; frame-ancestors 'none'; form-action 'none'; base-uri 'none'"},
    {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"}
  ]}]
}
